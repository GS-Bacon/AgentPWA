{
  "name": "agentpwa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n hub,web -c yellow,cyan \"npm:dev -w @agentpwa/hub\" \"npm:dev -w @agentpwa/web\"",
    "build": "npm run build -w @agentpwa/web",
    "start": "npm run build && npm run start -w @agentpwa/hub",
    "typecheck": "tsc -p packages/shared && tsc -p packages/driver-claude && tsc -p packages/hub && tsc -p packages/web",
    "test": "npm test -w @agentpwa/hub -w @agentpwa/driver-claude"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
